# systemd unit for the easytouch pool dashboard.
# Owns the RS-485 serial bus and serves the HTTP JSON API + dashboard on :8080.
# Install steps: see "Run on a Raspberry Pi" in README.md.
#   sudo cp deploy/easytouch.service /etc/systemd/system/
#   sudo systemctl enable --now easytouch
# Adjust User=, the two /home/pi/pool paths, and --port to match your Pi.
[Unit]
Description=easytouch pool dashboard (serial bus + HTTP API)
# Only one stack may own the serial device; see the note in easytouch-ts.service.
Conflicts=easytouch-ts.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# Grants serial-port access without editing the login user's groups.
SupplementaryGroups=dialout
# Port 80 is privileged and this runs as pi, so systemd hands the process just
# this one capability — the ability to bind a low port — and nothing else.
# Preferred over `setcap` on the interpreter, which would grant it to every
# python process on the box. (Adding NoNewPrivileges= would disable this.)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/home/pi/pool
# USB RS-485 adapter. If the ttyUSB number ever drifts (multiple USB serial
# devices), use the stable /dev/serial/by-id/usb-...  symlink instead.
ExecStart=/home/pi/pool/.venv/bin/python -m easytouch --port /dev/ttyUSB0 serve --http-port 80
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
